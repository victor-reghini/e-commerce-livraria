# ==============================================================================
# PLATAFORMA E-COMMERCE, PDV & GESTÃO MULTI-TENANT
# Configurações de Ambiente (Twelve-Factor App)
# Copie para .env e ajuste os valores conforme o ambiente (dev, staging, prod)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ambiente e Servidor
# ------------------------------------------------------------------------------
ENVIRONMENT=development
SERVER_PORT=8080
LOG_LEVEL=INFO
APP_NAME=ecommerce-backend

# ------------------------------------------------------------------------------
# 2. Banco de Dados (PostgreSQL 16 com RLS)
# Local: PostgreSQL Container / Produção: PostgreSQL VPS ou AWS RDS Aurora
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecommerce_db
SPRING_DATASOURCE_USERNAME=ecommerce_user
SPRING_DATASOURCE_PASSWORD=ecommerce_secret_password
DATABASE_NAME=ecommerce_db
DATABASE_USER=ecommerce_user
DATABASE_PASSWORD=ecommerce_secret_password
DATABASE_PORT=5432
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5

# ------------------------------------------------------------------------------
# 3. Cache & Sessões (Redis 7)
# Local: Redis Container / Produção: Redis VPS ou AWS ElastiCache
# ------------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=redis_secret_password
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Mensageria Assíncrona (RabbitMQ 3)
# ------------------------------------------------------------------------------
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=rabbit_user
SPRING_RABBITMQ_PASSWORD=rabbit_secret_password
RABBITMQ_DEFAULT_USER=rabbit_user
RABBITMQ_DEFAULT_PASS=rabbit_secret_password
RABBITMQ_MANAGEMENT_PORT=15672

# ------------------------------------------------------------------------------
# 5. Armazenamento de Arquivos / S3 (MinIO Local ou AWS S3 Nativo)
# Local VPS: http://localhost:9000 (MinIO)
# AWS Prod: https://s3.us-east-1.amazonaws.com (ou deixe vazio para AWS padrão)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minio_admin_user
AWS_SECRET_ACCESS_KEY=minio_admin_secret_password
AWS_S3_BUCKET_MEDIA=ecommerce-media
AWS_S3_BUCKET_EBOOKS=ecommerce-ebooks
AWS_ENDPOINT_URL=http://localhost:9000
AWS_S3_PATH_STYLE_ACCESS_ENABLED=true
MINIO_ROOT_USER=minio_admin_user
MINIO_ROOT_PASSWORD=minio_admin_secret_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# 6. Segurança, Autenticação e JWT
# Gere um segredo de no mínimo 256 bits (32+ caracteres) em produção
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-jwt-signing-key-ecommerce-platform-2026-production-ready-key
JWT_EXPIRATION_SECONDS=86400
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ------------------------------------------------------------------------------
# 7. Traefik Proxy & Domínios (Produção VPS)
# ------------------------------------------------------------------------------
TRAEFIK_DASHBOARD_ENABLED=true
TRAEFIK_ACME_EMAIL=admin@seudominio.com.br
DOMAIN_NAME=seudominio.com.br
BACKEND_SUBDOMAIN=api.seudominio.com.br
GRAFANA_SUBDOMAIN=grafana.seudominio.com.br

# ------------------------------------------------------------------------------
# 8. Observabilidade & Monitoramento de Logs (Grafana, Loki & Prometheus)
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secret_password
GRAFANA_PORT=3030
PROMETHEUS_PORT=9090
LOKI_PORT=3100

